{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "lib": ["ESNext"]
  },
  // Pure modules outside src/core that must stay Foundry-free are listed
  // explicitly in `include` below, so `tsc` proves them Foundry-free. Their
  // test dirs (tests/config, tests/settings, tests/lang,
  // tests/data) stay out: they import JSON modules / node built-ins whose type
  // graphs need types this project strips (`types: []`). ESLint's
  // no-restricted-globals block still fences those test dirs against Foundry
  // globals.
  "include": ["src/core", "tests/core", "src/config.ts", "src/settings/registry.ts", "src/data/item/subtypes.ts", "src/data/item/choices.ts", "src/data/actor/subtypes.ts", "src/data/derive", "src/data/active-effect/subtypes.ts", "src/data/migrations.ts", "src/data/import/envelope.ts", "src/conditions.ts", "src/sheets/character/context-types.ts", "src/sheets/character/xp.ts", "src/sheets/character/drop-rules.ts", "src/sheets/character/grouping.ts", "src/sheets/character/context.ts", "src/sheets/creature/context-types.ts", "src/sheets/creature/context.ts", "src/sheets/kit", "tests/sheets", "src/combat", "tests/combat", "src/magic", "tests/magic"],
  // initiative-modifier-dialog.ts is Foundry-shell glue (DialogV2, game.i18n,
  // DOM), same category as e.g. src/sheets/character/combat-rolls.ts — those
  // sibling files just aren't swept in by a directory-level `include` entry.
  // src/combat's entry above is directory-level (unlike sheets/character's
  // file-by-file listing), so this one file needs an explicit carve-out to
  // keep the rest of src/combat proven Foundry-free.
  // spell-actions.test.ts drives the Foundry-coupled memorizeSpell (it pulls
  // src/sheets/character/spell-actions.ts and its Foundry-global imports into
  // this type graph), so it is carved out of the directory-level tests/sheets
  // include, the same way initiative-modifier-dialog.ts is carved out above.
  // kit-power-actions.test.ts (SP11 Plan B) drives the Foundry-coupled
  // usePower/resetPower glue, so it is carved out the same way.
  "exclude": ["src/combat/initiative-modifier-dialog.ts", "tests/sheets/character/spell-actions.test.ts", "tests/sheets/character/kit-power-actions.test.ts", "tests/sheets/character/turning-actions.test.ts", "tests/sheets/character/psionic-actions.test.ts", "tests/sheets/character/psionic-combat.test.ts", "tests/hooks/psionic-hooks.test.ts", "tests/core/psionics/wild.test.ts"]
}
