<div class="adnd2e chat-card martial-arts-attack">
  <header>
    <img src="{{actorImg}}" alt="{{actorName}}">
    <h3>{{actorName}} — {{styleName}}</h3>
  </header>
  {{#if maneuverKey}}<p class="formula">{{localize maneuverKey}} — {{localize costKey}}</p>{{/if}}
  {{#if targetName}}<p class="hint">{{localize 'ADND2E.chat.martialArts.against' target=targetName}}</p>{{/if}}
  {{#if noStyleDie}}<p class="hint">{{localize 'ADND2E.chat.martialArts.noStyleDie'}}</p>{{/if}}
  {{#if breakdown.length}}
    <ul class="modifiers">
      {{#each breakdown as |m|}}<li>{{localize m.labelKey}}: {{adnd2eSigned m.amount}}</li>{{/each}}
    </ul>
  {{/if}}
  {{#unless noRoll}}
    <p class="formula">1d20 = <strong>{{natural}}</strong> — {{localize 'ADND2E.chat.martialArts.needed' total=total needed=needed}}</p>
    <p class="result {{#if hit}}hit{{else}}miss{{/if}}">{{localize resultKey}}</p>
  {{/unless}}
  {{#if outcomeKey}}<p class="hint">{{localize outcomeKey}}</p>{{/if}}
  {{#each lines as |l|}}<p class="hint">{{localize l.key n1=l.n1 n2=l.n2}}</p>{{/each}}
  {{#if hit}}
    {{#if ineffective}}<p class="result miss">{{localize 'ADND2E.chat.martialArts.noEffect'}} {{localize ineffective.requirementKey}}</p>{{/if}}
    {{#if blowKey}}<p class="formula">{{localize blowKey}} — {{localize 'ADND2E.chat.martialArts.damage' damage=damage}}</p>{{/if}}
    {{#if formula}}<p class="formula">{{formula}} = <strong>{{damage}}</strong> {{localize 'ADND2E.chat.martialArts.hp'}}</p>{{/if}}
    {{#if stunTrigger}}<p class="hint">{{localize 'ADND2E.chat.martialArts.stun'}}</p>{{/if}}
    {{#if damage}}<button type="button" data-action="applyDamage" data-amount="{{damage}}">{{localize 'ADND2E.chat.damage.applyToTargets'}}</button>{{/if}}
  {{/if}}
  {{#if effects.length}}
    <ul class="modifiers">
      {{#each effects as |e|}}
        <li>
          <strong>{{localize e.labelKey}}</strong>
          {{#if e.saveKey}} - {{localize e.saveKey mod=e.saveMod}}{{/if}}
          {{#if e.condition}}
            <button type="button" data-action="applyCondition" data-condition="{{e.condition}}" data-rounds="{{e.rounds}}"{{#if e.self}} data-self="true"{{/if}}>{{localize 'ADND2E.chat.martialArts.applyPrefix'}} {{localize e.labelKey}}{{#if e.rounds}} ({{e.rounds}}){{/if}}</button>
            {{#if e.self}}<span class="hint">{{localize 'ADND2E.chat.martialArts.appliesToYou'}}</span>{{/if}}
            {{#if e.deferred}}<span class="hint">{{localize 'ADND2E.chat.martialArts.whenHoldEnds'}}</span>{{/if}}
          {{/if}}
          {{#if e.damage}}
            <button type="button" data-action="applyDamage" data-amount="{{e.damage}}">{{localize 'ADND2E.chat.damage.applyToTargets'}} ({{e.damage}})</button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{/if}}
</div>
