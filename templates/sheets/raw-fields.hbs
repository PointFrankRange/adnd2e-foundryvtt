<div class="adnd2e raw-field-sheet scrollable">
  <div class="raw-field-list">
    <section class="kit-panel raw-header">
      <div class="kit-body">
        {{#each header}}
          {{#if (eq this.path "name")}}
            <div class="raw-title-row">
              {{#if @root.hasPortrait}}
                <img class="raw-portrait" width="48" height="48"
                  src="{{#if @root.portrait}}{{@root.portrait}}{{else}}{{@root.portraitPlaceholder}}{{/if}}" alt=""
                  {{#unless @root.portrait}}data-placeholder="{{@root.portraitPlaceholder}}"{{/unless}}
                  {{#if @root.editable}}data-action="editImage" data-edit="img"{{/if}}>
              {{/if}}
              <input type="text" class="raw-name" name="name" value="{{this.value}}" placeholder="{{this.label}}"
                {{#unless @root.editable}}readonly{{/unless}}>
            </div>
            {{#if @root.subtitle}}<div class="raw-subtitle">{{@root.subtitle}}</div>{{/if}}
          {{else if (eq this.path "img")}}
            {{!-- #148: the image is shown as the portrait above and chosen with the file picker, not typed as a path --}}
          {{else}}
            <div class="form-group">
              <label>{{this.label}}</label>
              <div class="form-fields">
                <input type="text" name="{{this.path}}" value="{{this.value}}"
                  {{#unless @root.editable}}readonly{{/unless}}>
              </div>
            </div>
          {{/if}}
        {{/each}}
      </div>
    </section>

    {{#if strip.length}}
      <section class="kit-panel raw-strip">
        <div class="kit-body raw-strip-body">
          {{#each strip}}
            <div class="raw-strip-item display-{{this.display}}">
              {{> adnd2e.raw-field-row this.row indent=0}}
              {{#if (eq this.display "chips")}}
                <span class="raw-chips">{{#each this.row.choices}}{{#if this.selected}}<span class="chip">{{this.label}}</span>{{/if}}{{/each}}</span>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if leading.length}}
      <div class="raw-groups">{{#each leading}}{{> adnd2e.raw-group this}}{{/each}}</div>
    {{/if}}

    {{#if description}}
      <section class="kit-panel raw-description">
        <div class="kit-bar">{{localize 'ADND2E.sheets.descriptionTitle'}}</div>
        <div class="kit-body">
          <textarea name="{{description.path}}" rows="12"
            {{#unless @root.editable}}readonly{{/unless}}>{{description.value}}</textarea>
        </div>
      </section>
    {{/if}}

    <div class="raw-groups">
      {{#each groups}}{{> adnd2e.raw-group this}}{{/each}}
    </div>

    {{#if itemEffects}}{{> adnd2e.raw-effects}}{{/if}}
  </div>

  {{#if editable}}
    <footer class="sheet-footer flexrow">
      <button type="submit"><i class="fa-solid fa-floppy-disk"></i> Save</button>
    </footer>
  {{/if}}
</div>
