  <section class="kit-panel favorites">
    <div class="kit-bar">★ {{localize 'ADND2E.sheet.kit.favorites'}}</div>
    <div class="kit-body">
      {{#each adnd2e.favorites.rows as |f|}}
        <div class="favorite-row">
          {{#if f.img}}<img src="{{f.img}}" alt="" width="20" height="20">{{/if}}
          <span class="name">{{#if f.nameIsKey}}{{localize f.name}}{{else}}{{f.name}}{{/if}}</span>
          {{#if f.detail}}<span class="detail">{{f.detail}}</span>{{/if}}
          {{#if f.action}}<button type="button" class="kit-roll" data-action="{{f.action}}"{{#if f.itemId}} data-item-id="{{f.itemId}}"{{/if}}{{#if f.skill}} data-skill="{{f.skill}}"{{/if}}><i class="{{f.icon}}" inert></i></button>{{/if}}
          {{#if @root.adnd2e.favorites.canFavorite}}<button type="button" class="kit-star on" data-action="toggleFavorite" data-kind="{{f.kind}}" data-id="{{f.id}}" title="{{localize 'ADND2E.sheet.kit.favorite'}}">★</button>{{/if}}
        </div>
      {{else}}
        <p class="kit-empty">{{localize 'ADND2E.sheet.kit.noFavorites'}}</p>
      {{/each}}
    </div>
  </section>

  {{#if adnd2e.spells.casting}}
    <section class="kit-panel kit-casting">
      <div class="kit-bar">{{localize 'ADND2E.sheet.casting.title'}}: {{adnd2e.spells.casting.spellName}}</div>
      <div class="kit-body">
        <p class="detail">{{localize adnd2e.spells.casting.detailKey value=adnd2e.spells.casting.detailValue}}</p>
        {{#if adnd2e.spells.casting.canComplete}}<button type="button" class="kit-roll" data-action="completeCasting">{{localize 'ADND2E.sheet.casting.complete'}}</button>{{/if}}
        {{#if adnd2e.spells.casting.canGmControl}}
          <button type="button" data-action="disruptCasting">{{localize 'ADND2E.sheet.casting.disrupt'}}</button>
          <button type="button" data-action="cancelCasting">{{localize 'ADND2E.sheet.casting.cancel'}}</button>
        {{/if}}
      </div>
    </section>
  {{/if}}

  {{#if adnd2e.vitals.prone}}
    <section class="kit-panel kit-prone">
      <div class="kit-bar">{{localize 'ADND2E.sheet.combat.proneTitle'}}</div>
      <div class="kit-body">
        <p class="detail">{{localize 'ADND2E.sheet.combat.proneHint'}}</p>
        {{#if @root.pcActions}}<button type="button" class="kit-roll" data-action="standUp">{{localize 'ADND2E.sheet.combat.standUp'}}</button>{{/if}}
      </div>
    </section>
  {{/if}}

  {{#if @root.pcActions}}{{#if adnd2e.combat.wrestling}}
    <section class="kit-panel kit-wrestle">
      <div class="kit-bar">{{localize 'ADND2E.sheet.combat.wrestleTitle'}}</div>
      <div class="kit-body">
        {{#if adnd2e.vitals.grapple}}
          <p class="detail">{{localize 'ADND2E.sheet.combat.grappleWith' name=adnd2e.vitals.grapple.opponentName}} - {{localize adnd2e.vitals.grapple.rungKey}}</p>
          {{#if @root.pcActions}}
            {{#if adnd2e.vitals.grapple.canImprove}}
              <button type="button" class="kit-roll" data-action="improveGrip">{{localize 'ADND2E.chat.wrestling.kind.improve'}}</button>
              <button type="button" class="kit-roll" data-action="holdOn">{{localize 'ADND2E.chat.wrestling.kind.holdOn'}}</button>
            {{/if}}
            {{#if adnd2e.vitals.grapple.canRelease}}<button type="button" data-action="releaseGrapple">{{localize 'ADND2E.sheet.combat.release'}}</button>{{/if}}
            {{#if adnd2e.vitals.grapple.canBreakFree}}<button type="button" class="kit-roll" data-action="breakFree">{{localize 'ADND2E.chat.wrestling.kind.breakFree'}}</button>{{/if}}
            {{#each adnd2e.vitals.grapple.lockOptions as |l|}}<button type="button" class="kit-roll" data-action="chooseLock" data-lock="{{l.id}}">{{localize l.labelKey}}</button>{{/each}}
          {{/if}}
        {{else}}
          {{#if @root.pcActions}}<button type="button" class="kit-roll" data-action="wrestle">{{localize 'ADND2E.sheet.combat.wrestle'}}</button>{{/if}}
        {{/if}}
      </div>
    </section>
  {{/if}}{{/if}}

  {{#if @root.pcActions}}{{#if @root.martialArts.visible}}
    <section class="kit-panel kit-martial-arts">
      <div class="kit-bar">{{localize 'ADND2E.sheet.martialArts.title'}}</div>
      <div class="kit-body">
        {{#if @root.adnd2e.lock.unlocked}}
          <label class="detail-field"><input type="checkbox" name="system.martialArts.knowsBasics"{{#if @root.martialArts.knowsBasics}} checked{{/if}}> <span>{{localize 'ADND2E.sheet.martialArts.knowsBasics'}}</span></label>
        {{else}}
          <p class="hint">{{#if @root.martialArts.knowsBasics}}{{localize 'ADND2E.sheet.martialArts.basicsKnown'}}{{else}}{{localize 'ADND2E.sheet.martialArts.basicsUnknown'}}{{/if}}</p>
        {{/if}}
        {{#each @root.martialArts.styles as |s|}}
          <div class="trait-row" data-item-id="{{s.id}}">
            <span class="name">{{s.name}}{{#if s.active}} — {{localize 'ADND2E.sheet.martialArts.active'}}{{/if}}</span>
            <span class="effect">{{localize s.formKey}} / {{localize s.methodKey}} ({{localize s.attackFormKey}})</span>
            <span class="effect">{{localize 'ADND2E.sheet.martialArts.acMod'}} {{adnd2eSigned s.acMod}}</span>
            <span class="effect">{{localize 'ADND2E.sheet.martialArts.damageDie'}} {{#if s.damageDie}}{{s.damageDie}}{{else}}{{localize 'ADND2E.sheet.martialArts.byWeapon'}}{{/if}}</span>
            <span class="effect">{{localize 'ADND2E.sheet.martialArts.slots'}} {{s.slots}}</span>
            <button type="button" class="kit-small" data-action="useMartialStyle" data-item-id="{{s.id}}"{{#if s.active}} disabled{{/if}}>{{localize 'ADND2E.sheet.martialArts.use'}}</button>
            {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=s.id deletable=true}}{{/if}}
            {{#if s.maneuvers.length}}
              <div class="kit-powers">
                <h5 class="kit-subhead">{{localize 'ADND2E.sheet.martialArts.maneuvers'}}</h5>
                {{#each s.maneuvers as |m|}}
                  <div class="power-row" data-maneuver-id="{{m.id}}">
                    <span class="name">{{localize m.nameKey}}</span>
                    <span class="effect">{{localize m.listKey}} {{m.difficulty}} — {{localize m.costKey}}</span>
                    {{#if m.reasonKey}}<span class="effect">{{localize m.reasonKey}}</span>{{/if}}
                    {{#if (eq m.kind 'passive')}}
                      {{#if (eq m.state 'known')}}<span class="effect">{{localize 'ADND2E.sheet.martialArts.passive'}}</span> <span class="effect">{{localize m.effectKey}}</span>{{/if}}
                    {{/if}}
                    {{#if (eq m.state 'known')}}
                      {{#unless (eq m.kind 'passive')}}<button type="button" class="kit-small" data-action="useManeuver" data-maneuver-id="{{m.id}}"{{#unless m.usable}} disabled{{/unless}}>{{localize 'ADND2E.sheet.martialArts.useManeuver'}}</button>{{/unless}}
                      {{#if @root.adnd2e.lock.unlocked}}<button type="button" class="kit-small" data-action="unlearnManeuver" data-item-id="{{s.id}}" data-maneuver-id="{{m.id}}">{{localize 'ADND2E.sheet.martialArts.unlearn'}}</button>{{/if}}
                    {{else if (eq m.state 'learnable')}}
                      <button type="button" class="kit-small" data-action="learnManeuver" data-item-id="{{s.id}}" data-maneuver-id="{{m.id}}">{{localize 'ADND2E.sheet.martialArts.learn'}}</button>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            {{/if}}
          </div>
        {{else}}
          <p class="kit-empty">{{localize 'ADND2E.sheet.martialArts.noStyles'}}</p>
        {{/each}}
        {{#if @root.martialArts.constants.summary.length}}
          <h5 class="kit-subhead">{{localize 'ADND2E.sheet.martialArts.constants'}}</h5>
          {{#each @root.martialArts.constants.summary as |c|}}
            <p class="hint"><strong>{{localize c.nameKey}}</strong> - {{localize c.effectKey}}</p>
          {{/each}}
        {{/if}}
        <p class="hint">{{localize 'ADND2E.sheet.martialArts.extraAttack'}}</p>
        <button type="button" class="kit-roll" data-action="martialArtsAttack"{{#unless @root.martialArts.canAttack}} disabled{{/unless}}>{{localize 'ADND2E.sheet.martialArts.attack'}}</button>
      </div>
    </section>
  {{/if}}{{/if}}

  {{#if adnd2e.vitals.fatigue}}
    <section class="kit-panel kit-fatigue">
      <div class="kit-bar">{{adnd2e.vitals.fatigue.label}}</div>
      <div class="kit-body">
        <p class="detail">{{localize adnd2e.vitals.fatigue.hintKey}}</p>
        {{#if adnd2e.vitals.canRecoverFatigue}}
        <button type="button" class="kit-roll" data-action="recoverFromFatigue">{{localize 'ADND2E.sheet.spells.recoverFromFatigue'}}</button>
        {{/if}}
      </div>
    </section>
  {{/if}}

  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.kit.attacks'}}</div>
    <div class="kit-body">
      {{#if @root.shapechange.form}}
      <h4 class="kit-subhead">{{localize 'ADND2E.sheet.shapechange.formAttacks'}}: {{@root.shapechange.form.name}}</h4>
      {{#each @root.shapechange.form.attacks as |a|}}
        <div class="weapon-row form-attack-row equipped">
          <span class="name">{{a.name}}</span>
          <span class="count">x{{a.count}}</span>
          <span class="damage">{{a.damage}}</span>
          <button type="button" class="kit-roll" data-action="rollFormAttack" data-index="{{@index}}">{{localize 'ADND2E.sheet.shapechange.rollFormAttack'}}</button>
        </div>
      {{else}}
        <p class="kit-empty">{{localize 'ADND2E.sheet.combat.noWeapons'}}</p>
      {{/each}}
      {{else}}
      {{#each adnd2e.combat.weapons as |w|}}
        <div class="weapon-row{{#if w.equipped}} equipped{{/if}}" data-item-id="{{w.id}}">
          <span class="name">{{w.name}}</span>
          <span class="equipped-state">{{#if w.equipped}}{{localize 'ADND2E.sheet.combat.equipped'}}{{else}}{{localize 'ADND2E.sheet.combat.notEquipped'}}{{/if}}</span>
          <span class="damage">{{w.damageNote}}</span>
          <span class="speed" title="{{localize 'ADND2E.sheet.combat.speedFactor'}}">{{w.speedFactor}}</span>
          {{#if w.range}}<span class="range">{{w.range}}</span>{{/if}}
          {{#if w.grandMasteryExtraAttack}}<span class="badge grand-mastery" title="{{localize 'ADND2E.sheet.combat.grandMasteryExtraAttack'}}">{{localize 'ADND2E.sheet.skills.masteryTier.3'}}</span>{{/if}}
          {{#if w.specialistAttackRate}}<span class="badge specialist-rate" title="{{localize 'ADND2E.sheet.combat.specialistAttackRateTitle' attacks=w.specialistAttackRate.attacks rounds=w.specialistAttackRate.rounds}}">{{localize 'ADND2E.sheet.combat.specialistAttackRateBadge' attacks=w.specialistAttackRate.attacks rounds=w.specialistAttackRate.rounds}}</span>{{/if}}
          {{#if w.equipped}}
            {{#if w.canBackstab}}<label class="backstab-label"><input type="checkbox" class="backstab-toggle" data-item-id="{{w.id}}"> {{localize 'ADND2E.sheet.combat.backstab'}}</label>{{/if}}
            {{#if w.ammoType}}
              <select class="ammo-select" data-item-id="{{w.id}}" data-field="selectedAmmoId">
                {{#if w.ammoOptions.length}}
                  {{#each w.ammoOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
                {{else}}
                  <option value="" disabled selected>{{localize 'ADND2E.sheet.combat.noAmmo'}}</option>
                {{/if}}
              </select>
            {{/if}}
            {{#if @root.adnd2e.combat.maneuverOptions.length}}
              <select class="maneuver-select" data-item-id="{{w.id}}">
                <option value="">{{localize 'ADND2E.sheet.combat.maneuverNone'}}</option>
                {{#each @root.adnd2e.combat.maneuverOptions as |opt|}}<option value="{{opt.value}}">{{localize opt.label}}</option>{{/each}}
              </select>
            {{/if}}
            <button type="button" class="kit-roll" data-action="rollAttack" data-item-id="{{w.id}}">{{localize 'ADND2E.sheet.combat.rollAttack'}}</button>
          {{/if}}
          {{#if @root.adnd2e.favorites.canFavorite}}<button type="button" class="kit-star{{#if w.favorite}} on{{/if}}" data-action="toggleFavorite" data-kind="item" data-id="{{w.id}}" title="{{localize 'ADND2E.sheet.kit.favorite'}}">★</button>{{/if}}
          {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=w.id deletable=true}}{{/if}}
        </div>
      {{else}}
        <p class="kit-empty">{{localize 'ADND2E.sheet.combat.noWeapons'}}</p>
      {{/each}}
      {{/if}}
    </div>
  </section>

  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.combat.armor'}}</div>
    <div class="kit-body">
      {{#each adnd2e.combat.armor as |a|}}
        <div class="armor-row{{#if a.equipped}} equipped{{/if}}" data-item-id="{{a.id}}">
          <span class="name">{{a.name}}{{#if a.isShield}} <span class="badge">{{localize 'ADND2E.sheet.combat.shield'}}</span>{{/if}}</span>
          <span class="ac">{{a.baseAc}}</span>
          <span class="equipped-state">{{#if a.equipped}}{{localize 'ADND2E.sheet.combat.equipped'}}{{else}}{{localize 'ADND2E.sheet.combat.notEquipped'}}{{/if}}</span>
          {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=a.id deletable=true}}{{/if}}
        </div>
      {{else}}
        <p class="kit-empty">{{localize 'ADND2E.sheet.combat.noArmor'}}</p>
      {{/each}}
      <ul class="ac-breakdown">
        {{#each adnd2e.combat.acBreakdown as |row|}}<li class="kit-stat"><div class="kit-bar">{{localize row.label}}</div><span class="kit-big">{{row.value}}</span></li>{{/each}}
      </ul>
    </div>
  </section>
