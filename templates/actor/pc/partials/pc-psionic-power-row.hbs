<div class="power-row" data-item-id="{{p.id}}">
  <span class="name">{{p.name}}</span>
  <span class="effect">{{localize (concat 'ADND2E.sheet.psionics.kind.' p.kind)}}</span>
  <span class="effect">{{localize 'ADND2E.sheet.psionics.score'}} {{p.score}}</span>
  <span class="effect">{{localize 'ADND2E.sheet.psionics.cost'}} {{p.cost}}{{#if p.costNote}} ({{p.costNote}}){{/if}}</span>
  {{#unless (eq p.unit "none")}}<span class="effect">{{localize 'ADND2E.sheet.psionics.maintenance'}} {{p.maintenance}} / {{localize (concat 'ADND2E.sheet.psionics.unit.' p.unit)}}</span>{{/unless}}
  {{#if p.range}}<span class="effect">{{p.range}}</span>{{/if}}
  {{#if @root.pcActions}}
  <button type="button" class="kit-small" data-action="usePsionicPower" data-power-id="{{p.id}}"{{#unless p.canUse}} disabled{{/unless}}>{{localize 'ADND2E.sheet.psionics.use'}}</button>
  {{#if p.canRelearn}}<button type="button" class="kit-small" data-action="relearnPsionicPower" data-power-id="{{p.id}}">{{localize 'ADND2E.sheet.psionics.relearn'}}</button>{{/if}}
  {{/if}}
  {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=p.id deletable=true}}{{/if}}
</div>
