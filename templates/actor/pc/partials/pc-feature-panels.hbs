  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.tabs.features'}}</div>
    <div class="kit-body">
      {{#each adnd2e.features.groups as |grp|}}
        <div class="feature-group" data-source-type="{{grp.sourceType}}">
          <h4 class="kit-subhead">{{localize grp.sourceTypeLabel}}</h4>
          {{#each grp.items as |f|}}
            <div class="feature-row" data-item-id="{{f.id}}">
              <span class="name">{{f.name}}</span>
              {{#if f.uses}}
                <span class="uses">{{f.uses.value}} / {{f.uses.max}} ({{f.uses.per}})</span>
              {{/if}}
              <div class="description">{{{f.description}}}</div>
              {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=f.id deletable=true}}{{/if}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="placeholder">{{localize 'ADND2E.sheet.features.none'}}</p>
      {{/each}}
    </div>
  </section>

  {{#if @root.pcActions}}
  {{#if @root.turning.canTurn}}
  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.turning.title'}}</div>
    <div class="kit-body">
      <p class="hint">{{localize 'ADND2E.sheet.turning.level'}}: {{@root.turning.level}}</p>
      <button type="button" class="kit-small" data-action="turnUndead"{{#if @root.turning.attempted}} disabled{{/if}}>{{localize 'ADND2E.sheet.turning.button'}}</button>
      {{#if @root.turning.attempted}}<p class="hint">{{localize 'ADND2E.sheet.turning.attempted'}}</p>{{/if}}
      {{#if @root.turning.canReset}}<button type="button" class="kit-small" data-action="resetTurnAttempt">{{localize 'ADND2E.sheet.turning.reset'}}</button>{{/if}}
    </div>
  </section>
  {{/if}}
  {{#if @root.shapechange.visible}}
  <section class="kit-panel shapechange-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.shapechange.title'}}</div>
    <div class="kit-body">
      <p class="hint">{{localize 'ADND2E.sheet.shapechange.usesLeft' left=@root.shapechange.usesLeft max=@root.shapechange.usesMax}}</p>
      {{#if @root.shapechange.categoriesUsed.length}}<p class="hint">{{localize 'ADND2E.sheet.shapechange.categoriesUsed'}}: {{#each @root.shapechange.categoriesUsed}}{{adnd2eLabel 'shapechangeCategories' this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
      {{#if @root.shapechange.form}}<p class="hint">{{localize 'ADND2E.sheet.shapechange.shifted' name=@root.shapechange.form.name}}</p>{{/if}}
      <button type="button" class="kit-small" data-action="shapechangeShift"{{#unless @root.shapechange.canShiftNow}} disabled{{/unless}}>{{localize 'ADND2E.sheet.shapechange.shift'}}</button>
      {{#if @root.shapechange.form}}<button type="button" class="kit-small" data-action="shapechangeReturn"{{#unless @root.shapechange.canAct}} disabled{{/unless}}>{{localize 'ADND2E.sheet.shapechange.returnToNormal'}}</button>{{/if}}
      <button type="button" class="kit-small" data-action="shapechangeNewDay">{{localize 'ADND2E.sheet.shapechange.newDay'}}</button>
    </div>
  </section>
  {{/if}}
  {{#if @root.tracking.visible}}
  <section class="kit-panel tracking-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.tracking.title'}}</div>
    <div class="kit-body">
      <p class="hint">{{localize 'ADND2E.sheet.tracking.score' wisdom=@root.tracking.wisdom level=@root.tracking.level}}</p>
      {{#if @root.adnd2e.lock.unlocked}}
        <div class="detail-fields">
        <label class="detail-field"><span class="cap">{{localize 'ADND2E.sheet.tracking.primaryTerrain'}}</span>
          <select name="system.tracking.primaryTerrain">{{selectOptions @root.primaryTerrains selected=@root.tracking.primaryTerrain localize=true blank=''}}</select>
        </label>
        <label class="detail-field"><input type="checkbox" name="system.tracking.specialized"{{#if @root.tracking.specialized}} checked{{/if}}> <span>{{localize 'ADND2E.sheet.tracking.specialized'}}</span></label>
        </div>
      {{else}}
        <p class="hint">{{localize 'ADND2E.sheet.tracking.primaryTerrain'}}: {{#if @root.tracking.primaryTerrain}}{{adnd2eLabel 'primaryTerrains' @root.tracking.primaryTerrain}}{{#if @root.tracking.specialized}} ({{localize 'ADND2E.sheet.tracking.specializedShort'}}){{/if}}{{else}}—{{/if}}</p>
      {{/if}}
      <button type="button" class="kit-small" data-action="trackQuarry"{{#unless @root.tracking.canAct}} disabled{{/unless}}>{{localize 'ADND2E.sheet.tracking.track'}}</button>
    </div>
  </section>
  {{/if}}
  {{> adnd2e.pc-wild-talent-panel}}
  {{#if @root.kits.length}}
  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.kits.title'}}</div>
    <div class="kit-body">
      {{#each @root.kits as |k|}}
        <div class="trait-row" data-item-id="{{k.id}}">
          <span class="name">{{k.name}}</span>
          <span class="cost">{{k.chassisId}}</span>
          <span class="effect">{{#if k.xpModifierPercent}}{{localize 'ADND2E.sheet.kits.xp'}} {{k.xpModifierPercent}}%{{/if}}</span>
          {{#each k.effects as |e|}}<span class="effect">{{localize e.kindKey}}{{#if e.targetKey}} {{localize e.targetKey}}{{/if}} {{e.amount}}</span>{{/each}}
          {{#if k.grantedFeatures.length}}<span class="effect">{{localize 'ADND2E.sheet.kits.features'}}: {{#each k.grantedFeatures}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>{{/if}}
          {{#if k.overrides.castingDisabled}}<span class="effect">{{localize 'ADND2E.sheet.kits.castingDisabled'}}</span>{{/if}}
          {{#if k.overrides.turningKey}}<span class="effect">{{localize k.overrides.turningKey}}{{#if k.overrides.turningOffsetLabel}} {{k.overrides.turningOffsetLabel}}{{/if}}</span>{{/if}}
          {{#if k.overrides.removedAbilities.length}}<span class="effect">{{localize 'ADND2E.sheet.kits.removed'}}: {{#each k.overrides.removedAbilities}}<s class="removed">{{this}}</s>{{#unless @last}}, {{/unless}}{{/each}}</span>{{/if}}
          {{#if k.powers.length}}
            <div class="kit-powers">
              <h5 class="kit-subhead">{{localize 'ADND2E.sheet.kits.powers'}}</h5>
              {{#each k.powers as |p|}}
                <div class="power-row" data-power-id="{{p.id}}">
                  <span class="name">{{p.name}}</span>
                  {{#if p.atWill}}<span class="uses">{{localize 'ADND2E.sheet.kits.per.at-will'}}</span>{{else}}<span class="uses">{{p.remaining}} / {{p.uses}} {{localize p.perKey}}</span>{{/if}}
                  {{#if p.scope}}<span class="effect">{{p.scope}}</span>{{/if}}
                  {{#each p.params as |q|}}<span class="effect">{{q.key}}: {{q.value}}</span>{{/each}}
                  {{#unless p.managed}}
                  <button type="button" class="kit-small" data-action="useKitPower" data-kit-id="{{k.id}}" data-power-id="{{p.id}}"{{#unless p.canUse}} disabled{{/unless}}>{{localize 'ADND2E.sheet.kits.use'}}</button>
                  {{#if p.canReset}}<button type="button" class="kit-small" data-action="resetKitPower" data-kit-id="{{k.id}}" data-power-id="{{p.id}}">{{localize 'ADND2E.sheet.kits.resetPower'}}</button>{{/if}}
                  {{/unless}}
                </div>
              {{/each}}
            </div>
          {{/if}}
          {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=k.id deletable=true}}{{/if}}
        </div>
      {{/each}}
      <button type="button" class="kit-small" data-action="newDayKitPowers">{{localize 'ADND2E.sheet.kits.newDay'}}</button>
      <button type="button" class="kit-small" data-action="newEncounterKitPowers">{{localize 'ADND2E.sheet.kits.newEncounter'}}</button>
    </div>
  </section>
  {{/if}}
  {{#if @root.pcActions}}{{#if @root.martialArts.visible}}
  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.martialArts.manageTitle'}}</div>
    <div class="kit-body">
      {{#if @root.adnd2e.lock.unlocked}}
        <label class="detail-field"><input type="checkbox" name="system.martialArts.knowsBasics"{{#if @root.martialArts.knowsBasics}} checked{{/if}}> <span>{{localize 'ADND2E.sheet.martialArts.knowsBasics'}}</span></label>
      {{else}}
        <p class="hint">{{#if @root.martialArts.knowsBasics}}{{localize 'ADND2E.sheet.martialArts.basicsKnown'}}{{else}}{{localize 'ADND2E.sheet.martialArts.basicsUnknown'}}{{/if}}</p>
      {{/if}}
      {{#each @root.martialArts.styles as |s|}}
        <div class="trait-row" data-item-id="{{s.id}}">
          <span class="name style-name">{{s.name}}</span>
          <span class="effect">{{localize s.formKey}} / {{localize s.methodKey}} ({{localize s.attackFormKey}})</span>
          <span class="effect">{{localize 'ADND2E.sheet.martialArts.acMod'}} {{adnd2eSigned s.acMod}}</span>
          <span class="effect">{{localize 'ADND2E.sheet.martialArts.damageDie'}} {{#if s.damageDie}}{{s.damageDie}}{{else}}{{localize 'ADND2E.sheet.martialArts.byWeapon'}}{{/if}}</span>
          <span class="effect">{{localize 'ADND2E.sheet.martialArts.slots'}} {{s.slots}}</span>
          {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=s.id deletable=true}}{{/if}}
          {{#if s.maneuvers.length}}
            <div class="kit-powers">
              <h5 class="kit-subhead">{{localize 'ADND2E.sheet.martialArts.maneuvers'}}</h5>
              {{#each s.lists as |g|}}
              <div class="maneuver-list">
              <h6 class="maneuver-list-name">{{localize g.listKey}}</h6>
              {{#each g.maneuvers as |m|}}
                <div class="power-row{{#if (eq m.state 'locked')}} locked{{/if}}" data-maneuver-id="{{m.id}}">
                  <span class="name">{{localize m.nameKey}}</span>
                  <span class="effect">{{m.difficulty}} - {{localize m.costKey}}</span>
                  {{#if m.reasonKey}}<span class="effect">{{#if m.prereqNameKey}}{{localize m.reasonKey name=(localize m.prereqNameKey)}}{{else}}{{localize m.reasonKey}}{{/if}}</span>{{/if}}
                  {{#if (eq m.state 'known')}}
                    {{#if (eq m.kind 'passive')}}<span class="effect">{{localize 'ADND2E.sheet.martialArts.passive'}}</span>{{/if}}
                    <span class="effect">{{localize m.effectKey}}</span>
                    {{#if @root.adnd2e.lock.unlocked}}<button type="button" class="kit-small" data-action="unlearnManeuver" data-item-id="{{s.id}}" data-maneuver-id="{{m.id}}">{{localize 'ADND2E.sheet.martialArts.unlearn'}}</button>{{/if}}
                  {{else if (eq m.state 'learnable')}}
                    <button type="button" class="kit-small" data-action="learnManeuver" data-item-id="{{s.id}}" data-maneuver-id="{{m.id}}">{{localize 'ADND2E.sheet.martialArts.learn'}}</button>
                  {{/if}}
                </div>
              {{/each}}
              </div>
              {{/each}}
            </div>
          {{/if}}
        </div>
      {{else}}
        <p class="kit-empty">{{localize 'ADND2E.sheet.martialArts.noStyles'}}</p>
      {{/each}}
    </div>
  </section>
  {{/if}}{{/if}}
  {{#if adnd2e.traits.enabled}}
  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.traits.title'}}</div>
    <div class="kit-body">
      <div class="cp-ledger">
        <label>
          {{localize 'ADND2E.sheet.traits.pool'}}
          {{#if @root.adnd2e.lock.unlocked}}
            <input type="number" min="0" step="1" name="system.options.skillsAndPowers.characterPoints.pool" value="{{adnd2e.traits.pool}}"{{#unless adnd2e.traits.canEditPool}} disabled title="{{localize 'ADND2E.sheet.traits.poolGmOnly'}}"{{/unless}} />
          {{else}}
            <span>{{adnd2e.traits.pool}}</span>
          {{/if}}
        </label>
        <span class="cp-spent">{{localize 'ADND2E.sheet.traits.spent'}}: {{adnd2e.traits.ledger.spent}}</span>
        <span class="cp-available{{#if adnd2e.traits.ledger.overspent}} overspent{{/if}}">{{localize 'ADND2E.sheet.traits.available'}}: {{adnd2e.traits.ledger.available}}</span>
      </div>
      {{#if adnd2e.traits.ledger.overspent}}<p class="warning">{{localize 'ADND2E.sheet.traits.overspent'}}</p>{{/if}}
      {{#if adnd2e.traits.refundCapped}}<p class="hint">{{localize 'ADND2E.sheet.traits.refundCapped'}}</p>{{/if}}
      {{#each adnd2e.traits.rows as |row|}}
        <div class="trait-row{{#unless row.active}} inert{{/unless}}" data-item-id="{{row.id}}">
          <span class="name">{{row.name}}</span>
          <span class="cost">{{row.cost}}</span>
          <span class="effect">{{row.summaryAmount}} {{localize row.summaryTargetKey}}</span>
          {{#if @root.adnd2e.lock.unlocked}}{{#if row.canRemove}}<button type="button" data-action="removeTrait" data-item-id="{{row.id}}">{{localize 'ADND2E.sheet.traits.remove'}}</button>{{/if}}{{/if}}
          {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=row.id deletable=false}}{{/if}}
        </div>
      {{else}}
        <p class="placeholder">{{localize 'ADND2E.sheet.traits.none'}}</p>
      {{/each}}
    </div>
  </section>
  {{/if}}
  {{else}}
  {{#if adnd2e.traits.items.length}}
  <section class="kit-panel npc-traits">
    <div class="kit-bar">{{localize 'ADND2E.sheet.traits.title'}}</div>
    <div class="kit-body">
      {{#each adnd2e.traits.items as |row|}}
        <div class="trait-row{{#unless row.active}} inert{{/unless}}" data-item-id="{{row.id}}">
          <span class="name">{{row.name}}</span>
          <span class="effect">{{row.summaryAmount}} {{localize row.summaryTargetKey}}</span>
          {{#if @root.adnd2e.lock.unlocked}}{{#if row.canRemove}}<button type="button" data-action="removeTrait" data-item-id="{{row.id}}">{{localize 'ADND2E.sheet.traits.remove'}}</button>{{/if}}{{/if}}
        </div>
      {{/each}}
    </div>
  </section>
  {{/if}}
  {{/if}}

  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.features.racial'}}</div>
    <div class="kit-body">
      <ul class="kit-chips">
        {{#each adnd2e.features.racialAbilities as |ability|}}
          <li>{{ability}}</li>
        {{else}}
          <li class="placeholder">{{localize 'ADND2E.sheet.features.none'}}</li>
        {{/each}}
      </ul>
      {{#if adnd2e.features.racialXpLabel}}<p class="hint">{{localize 'ADND2E.sheet.features.racialXp'}}: {{adnd2e.features.racialXpLabel}}</p>{{/if}}
    </div>
  </section>

  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.features.languages'}}</div>
    <div class="kit-body">
      <p class="languages-max">{{adnd2e.features.languagesMax}}</p>
      <p class="hint">{{localize 'ADND2E.sheet.features.languagesHint'}}</p>
    </div>
  </section>

  <section class="kit-panel">
    <div class="kit-bar">{{localize 'ADND2E.sheet.features.resources'}}</div>
    <div class="kit-body">
      <label>
        {{localize 'ADND2E.sheet.features.reputation'}}
        {{#if @root.adnd2e.lock.unlocked}}
          <input type="text" name="system.resources.reputation" value="{{adnd2e.features.resources.reputation}}" />
        {{else}}
          <span>{{adnd2e.features.resources.reputation}}</span>
        {{/if}}
      </label>
      <label>
        {{localize 'ADND2E.sheet.features.henchmen'}}
        {{#if @root.adnd2e.lock.unlocked}}
          <input type="text" name="system.resources.henchmen" value="{{adnd2e.features.resources.henchmen}}" />
        {{else}}
          <span>{{adnd2e.features.resources.henchmen}}</span>
        {{/if}}
      </label>
      <label>
        {{localize 'ADND2E.sheet.features.followers'}}
        {{#if @root.adnd2e.lock.unlocked}}
          <input type="text" name="system.resources.followers" value="{{adnd2e.features.resources.followers}}" />
        {{else}}
          <span>{{adnd2e.features.resources.followers}}</span>
        {{/if}}
      </label>
    </div>
  </section>
