<div class="kit-ability" data-ability="{{row.key}}">
  <div class="kit-bar">{{localize row.label}}</div>
  <div class="kit-ability-grid">
    <div class="kit-ability-score">
      {{#if unlocked}}
        <input type="number" name="system.abilities.{{row.key}}.score" value="{{row.score}}"{{#if row.scoreLocked}} disabled title="{{localize 'ADND2E.sheet.subAbilities.mainLocked'}}"{{/if}}>
        <span class="effective">= {{row.effectiveScore}}</span>
      {{else}}
        <span class="kit-big">{{row.effectiveScore}}</span>
      {{/if}}
      {{#if row.racialDelta}}<span class="racial" title="{{localize 'ADND2E.sheet.abilityDelta.racial'}}">{{adnd2eSigned row.racialDelta}}</span>{{/if}}
      {{#if row.traitDelta}}<span class="trait" title="{{localize 'ADND2E.sheet.abilityDelta.trait'}}">{{adnd2eSigned row.traitDelta}}</span>{{/if}}
      {{#if row.showExceptional}}
        {{#if unlocked}}
          <input type="number" class="exceptional" name="system.abilities.str.exceptional" value="{{row.exceptional}}" placeholder="%">
        {{else if row.exceptional}}
          <span class="exceptional">/{{row.exceptional}}</span>
        {{/if}}
      {{/if}}
    </div>
    <div class="kit-mods">{{#each row.mods as |m|}}<div class="kit-mod" title="{{localize m.longKey}}"><span class="kit-mod-cap">{{localize m.shortKey}}</span><span class="kit-mod-val">{{m.display}}</span></div>{{/each}}</div>
  </div>
  {{#if row.subs}}
    <div class="sub-scores">
      {{#if unlocked}}
        {{#each row.subs as |sub|}}
          <label class="sub-score">{{localize sub.label}}<input type="number" min="1" max="25" name="{{sub.name}}" value="{{sub.value}}" placeholder="{{sub.placeholder}}"></label>
        {{/each}}
      {{else}}
        {{#each row.subs as |sub|}}
          <span class="sub-score">{{localize sub.label}} {{#if sub.value}}{{sub.value}}{{else}}{{sub.placeholder}}{{/if}}</span>
        {{/each}}
      {{/if}}
    </div>
  {{/if}}
</div>
