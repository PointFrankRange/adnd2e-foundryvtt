<section class="tab spells{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  {{#if adnd2e.spells.wizardSlots}}
    <section class="kit-panel">
      <div class="kit-bar">{{localize 'ADND2E.sheet.spells.wizardSlots'}}</div>
      <div class="kit-body">
        {{#if adnd2e.spells.specialistSchoolLabel}}
          <p class="specialist">
            {{localize 'ADND2E.sheet.spells.specialist'}}: {{localize adnd2e.spells.specialistSchoolLabel}}
          </p>
        {{/if}}
        {{> adnd2e.slot-table rows=adnd2e.spells.wizardSlots}}
      </div>
    </section>
  {{/if}}

  {{#if adnd2e.spells.channelling}}
    <section class="kit-panel">
      <div class="kit-bar">
        {{localize 'ADND2E.sheet.spells.channelling'}}
        {{#if @root.pcActions}}
        <button type="button" class="kit-small" data-action="recoverChannellerSp" style="margin-left:auto">
          {{localize 'ADND2E.sheet.spells.channellingRecover'}}
        </button>
        {{/if}}
      </div>
      <div class="kit-body">
        <p>{{adnd2e.spells.channelling.current}} / {{adnd2e.spells.channelling.max}}</p>
      </div>
    </section>
  {{else if adnd2e.spells.spellPoints}}
    <section class="kit-panel">
      <div class="kit-bar">{{localize 'ADND2E.sheet.spells.spellPoints'}}</div>
      <div class="kit-body">
        <p>{{adnd2e.spells.spellPoints.remaining}} / {{adnd2e.spells.spellPoints.max}}</p>
      </div>
    </section>
  {{/if}}

  {{#if adnd2e.spells.priestSlots}}
    <section class="kit-panel">
      <div class="kit-bar">{{localize 'ADND2E.sheet.spells.priestSlots'}}</div>
      <div class="kit-body">
        {{> adnd2e.slot-table rows=adnd2e.spells.priestSlots}}
      </div>
    </section>
  {{/if}}

  <section class="kit-panel">
    <div class="kit-bar">
      {{localize 'ADND2E.sheet.spells.known'}}
      <button type="button" class="kit-small" data-action="restSpellcasting" style="margin-left:auto">
        {{localize 'ADND2E.sheet.spells.rest'}}
      </button>
    </div>
    <div class="kit-body">
      {{#each adnd2e.spells.known as |grp|}}
        <div class="spell-level-group">
          <h4 class="kit-subhead">{{localize 'ADND2E.sheet.spells.level' level=grp.level}}</h4>
          {{#each grp.items as |s|}}
            <div class="spell-row{{#if s.expended}} expended{{/if}}" data-item-id="{{s.id}}">
              <span class="name">
                {{s.name}}
                {{#if s.inSpellbook}}
                  <span class="badge" title="{{localize 'ADND2E.sheet.spells.spellbook'}}">📖</span>
                {{/if}}
                {{#if s.expended}}
                  <span class="badge expended-badge" title="{{localize 'ADND2E.sheet.spells.expended'}}">✓</span>
                {{/if}}
              </span>
              {{#if s.schools.length}}
                <span class="schools">{{#each s.schools}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
              {{/if}}
              <span class="casting-time">{{s.castingTime}}</span>
              <span class="saving-throw">{{s.savingThrow}}</span>
              {{#if s.canLearn}}
                <button type="button" data-action="learnSpell" data-item-id="{{s.id}}">
                  {{localize 'ADND2E.sheet.spells.learn'}}
                </button>
              {{/if}}
              {{#if s.canMemorize}}
                <button type="button" data-action="memorizeSpell" data-item-id="{{s.id}}">
                  {{localize 'ADND2E.sheet.spells.memorize'}}
                </button>
              {{/if}}
              {{#if s.memorized}}
                <button type="button" data-action="forgetSpell" data-item-id="{{s.id}}">
                  {{localize 'ADND2E.sheet.spells.forget'}}
                </button>
              {{/if}}
              {{#if s.canCast}}
                <button type="button" data-action="castSpell" data-item-id="{{s.id}}">
                  {{localize 'ADND2E.sheet.spells.cast'}}
                </button>
              {{/if}}
              {{#if @root.adnd2e.favorites.canFavorite}}<button type="button" class="kit-star{{#if s.favorite}} on{{/if}}" data-action="toggleFavorite" data-kind="spell" data-id="{{s.id}}" title="{{localize 'ADND2E.sheet.kit.favorite'}}">★</button>{{/if}}
              {{#if @root.adnd2e.lock.unlocked}}{{> adnd2e.item-controls id=s.id deletable=true}}{{/if}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="placeholder">{{localize 'ADND2E.sheet.spells.none'}}</p>
      {{/each}}
    </div>
  </section>

  {{#if @root.pcActions}}
  {{#if adnd2e.spells.spellPoints}}
    <section class="kit-panel">
      <div class="kit-bar">
        {{localize 'ADND2E.sheet.spells.freeMagick'}}
        <button type="button" class="kit-small" data-action="memorizeFreeMagick" style="margin-left:auto">
          {{localize 'ADND2E.sheet.spells.memorizeFreeMagick'}}
        </button>
      </div>
      <div class="kit-body">
        {{#each adnd2e.spells.freeMagicks as |m|}}
          <div class="spell-row{{#if m.expended}} expended{{/if}}">
            <span class="name">
              {{localize 'ADND2E.sheet.spells.freeMagickEntry' level=m.level}}
              {{#if m.expended}}
                <span class="badge expended-badge" title="{{localize 'ADND2E.sheet.spells.expended'}}">✓</span>
              {{/if}}
            </span>
            {{#if m.canCast}}
              <button type="button" data-action="castFreeMagick" data-level="{{m.level}}">
                {{localize 'ADND2E.sheet.spells.cast'}}
              </button>
            {{/if}}
            <button type="button" data-action="forgetFreeMagick" data-level="{{m.level}}" data-expended="{{m.expended}}">
              {{localize 'ADND2E.sheet.spells.forget'}}
            </button>
          </div>
        {{else}}
          <p class="placeholder">{{localize 'ADND2E.sheet.spells.none'}}</p>
        {{/each}}
      </div>
    </section>
  {{else if adnd2e.spells.freeMagicks.length}}
    <section class="kit-panel">
      <div class="kit-bar">{{localize 'ADND2E.sheet.spells.freeMagick'}}</div>
      <div class="kit-body">
        <p class="placeholder">{{localize 'ADND2E.sheet.spells.freeMagickRuleOffHint'}}</p>
        {{#each adnd2e.spells.freeMagicks as |m|}}
          <div class="spell-row{{#if m.expended}} expended{{/if}}">
            <span class="name">
              {{localize 'ADND2E.sheet.spells.freeMagickEntry' level=m.level}}
              {{#if m.expended}}
                <span class="badge expended-badge" title="{{localize 'ADND2E.sheet.spells.expended'}}">✓</span>
              {{/if}}
            </span>
            <button type="button" data-action="forgetFreeMagick" data-level="{{m.level}}" data-expended="{{m.expended}}">
              {{localize 'ADND2E.sheet.spells.forget'}}
            </button>
          </div>
        {{/each}}
      </div>
    </section>
  {{/if}}
  {{/if}}

  {{#if adnd2e.spells.orphaned.length}}
    <section class="kit-panel">
      <div class="kit-bar">{{localize 'ADND2E.sheet.spells.orphaned'}}</div>
      <div class="kit-body">
        {{#each adnd2e.spells.orphaned as |o|}}
          <div class="spell-row orphaned">
            <span class="name">{{localize 'ADND2E.sheet.spells.orphanedEntry' level=o.spellLevel}}</span>
            <button type="button" data-action="forgetSpell" data-item-id="{{o.spellItemId}}">
              {{localize 'ADND2E.sheet.spells.forget'}}
            </button>
          </div>
        {{/each}}
      </div>
    </section>
  {{/if}}

</section>
