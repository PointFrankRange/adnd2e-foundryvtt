<section class="tab details scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="containers panel">
    <h3>{{localize 'ADND2E.sheet.tabs.inventory'}}</h3>

    {{#each adnd2e.inventory.containers as |grp|}}
      <div class="container-group{{#if grp.overCapacity}} over-capacity{{/if}}" data-item-id="{{grp.item.id}}">
        <div class="container-header">
          {{> adnd2e.item-row item=grp.item locationOptions=@root.adnd2e.inventory.locationOptions isGM=@root.user.isGM}}
          <span class="weight">{{grp.usedWeight}}{{#if grp.capacity}} / {{grp.capacity}} {{localize 'ADND2E.sheet.inventory.capacity'}}{{/if}}</span>
          {{#if grp.overCapacity}}<span class="warning">{{localize 'ADND2E.sheet.inventory.overCapacity'}}</span>{{/if}}
        </div>
        <div class="container-contents">
          {{#each grp.contents as |item|}}
            {{> adnd2e.item-row item=item locationOptions=@root.adnd2e.inventory.locationOptions isGM=@root.user.isGM}}
          {{else}}
            <p class="placeholder">{{localize 'ADND2E.sheet.inventory.empty'}}</p>
          {{/each}}
        </div>
      </div>
    {{/each}}

    <div class="loose-items">
      <h4>{{localize 'ADND2E.sheet.inventory.noContainer'}}</h4>
      {{#each adnd2e.inventory.loose as |item|}}
        {{> adnd2e.item-row item=item locationOptions=@root.adnd2e.inventory.locationOptions isGM=@root.user.isGM}}
      {{else}}
        <p class="placeholder">{{localize 'ADND2E.sheet.inventory.empty'}}</p>
      {{/each}}
    </div>
  </div>

  {{> adnd2e.encumbrance-gauge gauge=adnd2e.inventory.encumbrance}}

  <div class="currency panel">
    <h3>{{localize 'ADND2E.sheet.inventory.currency'}}</h3>
    <div class="currency-inputs">
      <label>PP <input type="number" min="0" name="system.currency.pp" value="{{adnd2e.inventory.currency.pp}}" /></label>
      <label>GP <input type="number" min="0" name="system.currency.gp" value="{{adnd2e.inventory.currency.gp}}" /></label>
      <label>EP <input type="number" min="0" name="system.currency.ep" value="{{adnd2e.inventory.currency.ep}}" /></label>
      <label>SP <input type="number" min="0" name="system.currency.sp" value="{{adnd2e.inventory.currency.sp}}" /></label>
      <label>CP <input type="number" min="0" name="system.currency.cp" value="{{adnd2e.inventory.currency.cp}}" /></label>
    </div>
  </div>

  <div class="feature-groups panel">
    <h3>{{localize 'ADND2E.sheet.tabs.features'}}</h3>
    {{#each adnd2e.features.groups as |grp|}}
      <div class="feature-group" data-source-type="{{grp.sourceType}}">
        <h4>{{localize grp.sourceTypeLabel}}</h4>
        {{#each grp.items as |f|}}
          <div class="feature-row" data-item-id="{{f.id}}">
            <span class="name">{{f.name}}</span>
            {{#if f.uses}}
              <span class="uses">{{f.uses.value}} / {{f.uses.max}} ({{f.uses.per}})</span>
            {{/if}}
            <div class="description">{{{f.description}}}</div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="placeholder">{{localize 'ADND2E.sheet.features.none'}}</p>
    {{/each}}
  </div>

  <div class="racial-abilities panel">
    <h3>{{localize 'ADND2E.sheet.features.racial'}}</h3>
    <ul>
      {{#each adnd2e.features.racialAbilities as |ability|}}
        <li>{{ability}}</li>
      {{else}}
        <li class="placeholder">{{localize 'ADND2E.sheet.features.none'}}</li>
      {{/each}}
    </ul>
  </div>

  <div class="languages panel">
    <h3>{{localize 'ADND2E.sheet.features.languages'}}</h3>
    <p class="languages-max">{{adnd2e.features.languagesMax}}</p>
    <p class="hint">{{localize 'ADND2E.sheet.features.languagesHint'}}</p>
  </div>

  <div class="resources panel">
    <h3>{{localize 'ADND2E.sheet.features.resources'}}</h3>
    <label>
      {{localize 'ADND2E.sheet.features.reputation'}}
      <input type="text" name="system.resources.reputation" value="{{adnd2e.features.resources.reputation}}" />
    </label>
    <label>
      {{localize 'ADND2E.sheet.features.henchmen'}}
      <input type="text" name="system.resources.henchmen" value="{{adnd2e.features.resources.henchmen}}" />
    </label>
    <label>
      {{localize 'ADND2E.sheet.features.followers'}}
      <input type="text" name="system.resources.followers" value="{{adnd2e.features.resources.followers}}" />
    </label>
  </div>

  <div class="identity-details panel">
    <h3>{{localize 'ADND2E.sheet.tabs.biography'}}</h3>
    <div class="detail-fields">
      {{#each adnd2e.biography.detailFields as |field|}}
        <label>
          {{localize (concat 'ADND2E.sheet.details.' field)}}
          <input type="text" name="system.details.{{field}}" value="{{lookup @root.source.system.details field}}" />
        </label>
      {{/each}}
    </div>
  </div>

  <div class="biography-text panel">
    <h3>{{localize 'ADND2E.sheet.biography.notes'}}</h3>
    {{formInput systemFields.biography value=source.system.biography name="system.biography" disabled=notEditable}}
  </div>

  <div class="campaign-notes panel">
    <h3>{{localize 'ADND2E.sheet.biography.campaignNotes'}}</h3>
    {{formInput systemFields.details.fields.campaignNotes value=source.system.details.campaignNotes name="system.details.campaignNotes" disabled=notEditable}}
  </div>

  {{#if adnd2e.biography.showGmNotes}}
    <div class="gm-notes panel">
      <h3>{{localize 'ADND2E.sheet.biography.gmNotes'}}</h3>
      {{formInput systemFields.details.fields.gmNotes value=source.system.details.gmNotes name="system.details.gmNotes" disabled=notEditable}}
    </div>
  {{/if}}

</section>
